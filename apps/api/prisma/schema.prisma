// 三角洲行动 · 哈夫币工具站 —— 数据模型
// 数据库使用 SQLite，无需登录/鉴权。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 哈夫币比例数据（模块一）
/// 通过多行记录保留历史，接口返回最新一条。
model Ratio {
  id           Int      @id @default(autoincrement())
  recycleRatio String // 回收比例，如 "1:35"（约定：1 元 ≈ 35 万哈夫币）
  rentRatio    String // 出租比例，如 "1:40"
  source       String // 数据来源
  updatedAt    DateTime @updatedAt // 更新时间
  createdAt    DateTime @default(now())

  @@map("ratios")
}

/// 出租账号信息登记（模块四）
/// 注意：仅收集“展示信息”，绝不收集账号密码 / 上号权限。
/// contact 字段仅后台可见，不对外公开展示。
model RentalIntent {
  id              Int      @id @default(autoincrement())
  coinAmount      Int // 哈夫币总量
  accountType     String // 纯币 / 含装备
  specialForcesLv String // 特勤处等级
  safeBoxType     String // 安全箱类型
  expectedRatio   String // 期望出租比例，如 "1:38"
  contact         String // 联系方式（仅后台可见，不公开）
  status          String   @default("pending") // pending | approved | rejected
  createdAt       DateTime @default(now())

  @@map("rental_intents")
}
